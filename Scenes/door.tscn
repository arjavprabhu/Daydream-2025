[sub_resource type="GDScript" id="GDScript_p0e35"]
script/source = "extends Area2D

@onready var game_manager: Node = $\"../GameManager\"

var entered = false

func _on_body_entered(body: CharacterBody2D):
	entered = true


func _on_body_exited(body):
	entered = false
	Globals.score += 1
func _process(delta):
	if entered == true:
		if Input.is_action_just_pressed(\"action\"):
			get_tree().change_scene_to_file(\"res://Scenes/w2.tscn\")
"

